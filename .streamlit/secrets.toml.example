# Copy this file to .streamlit/secrets.toml (which is git-ignored) and replace the placeholders.
# Generate real entries with:  python make_user.py
# The values below are PLACEHOLDERS and will not log anyone in.

[edulens.users.example_user]
name = "Example Faculty Name"
roles = ["Faculty Member"]                       # allowed: "Faculty Member", "Course Coordinator"
password_hash = "pbkdf2_sha256$600000$<salt_hex>$<hash_hex>"
